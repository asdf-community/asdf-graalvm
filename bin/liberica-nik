#!/usr/bin/env bash
set -eo pipefail

liberica_releases() {
  local cpu os arch
  cpu=$(uname -m)
  case "$cpu" in
    arm64 | aarch64) arch=arm ;;
    x86_64) arch=x86 ;;
    *) return 0 ;;
  esac

  case "$(uname -s)" in
    Darwin) os=macos ;;
    Linux)
      if [ -e "/lib/ld-musl-$cpu.so.1" ]; then
        os=linux-musl
      else
        os=linux
      fi
      ;;
    *) return 0 ;;
  esac

  curl -fsS --max-time 30 --get 'https://api.bell-sw.com/v1/nik/releases' \
    --data-urlencode "os=$os" --data-urlencode "arch=$arch" --data-urlencode 'bitness=64' \
    --data-urlencode 'bundle-type=standard' --data-urlencode 'package-type=tar.gz' \
    --data-urlencode 'build-type=all' --data-urlencode 'installation-type=archive' \
    --data-urlencode 'fields=version,filename,components,component,embedded' |
    jq -c '
      [.[] | . as $release
        | select(.version | test("^[0-9]+(\\.[0-9]+)*\\+[0-9]+$"))
        | .components[]
        | select(.component == "liberica" and .embedded)
        | select(.version | test("^25([.+])"))
        | {version: $release.version, filename: $release.filename, jdk: .version}]
    '
}

download_liberica() {
  local version=$1
  local archive=$2
  local release filename jdk_version tag asset download_url digest

  if ! release=$(liberica_releases | jq -er --arg version "$version" '.[] | select(.version == $version) | [.filename, .jdk] | @tsv'); then
    echo "Liberica NIK version $version is unavailable for this platform." >&2
    return 1
  fi
  read -r filename jdk_version <<<"$release"

  tag=$(jq -nr --arg tag "$version-$jdk_version" '$tag | @uri')
  if ! asset=$(
    "$(dirname "$0")/github-api" "https://api.github.com/repos/bell-sw/LibericaNIK/releases/tags/$tag" |
      jq -er --arg filename "$filename" '
        select(.draft == false and .prerelease == false)
        | .assets[]
        | select(.name == $filename)
        | select(.browser_download_url | startswith("https://github.com/bell-sw/LibericaNIK/releases/download/"))
        | select(.digest | type == "string" and test("^sha256:[0-9a-f]{64}$"))
        | [.browser_download_url, (.digest | ltrimstr("sha256:"))] | @tsv
      '
  ); then
    echo "Could not find a SHA-256 digest for $filename in BellSoft's release." >&2
    return 1
  fi
  read -r download_url digest <<<"$asset"

  curl -fLsS --retry 2 --max-time 300 --proto '=https' --proto-redir '=https' -o "$archive" "$download_url"

  if [ -n "$(command -v sha256sum)" ]; then
    set -- sha256sum
  else
    set -- shasum -a 256
  fi
  "$@" -c - <<EOF
$digest  $archive
EOF
}

case "$1" in
  list)
    liberica_releases | jq -r '
      map(.version) | unique
      | sort_by(split("+") | [(.[0] | split(".") | map(tonumber)), (.[1] | tonumber)])
      | .[] | "liberica-nik-\(.)"
    '
    ;;
  download)
    shift
    download_liberica "$@"
    ;;
esac
