#!/usr/bin/env bash
set -e

stage=$(mktemp -d "${ASDF_INSTALL_PATH%/*}/.graalvm.XXXXXX")
trap 'rm -rf "$stage"' EXIT
if [ -n "${ASDF_DOWNLOAD_PATH:-}" ]; then
  mkdir "$stage/jdk"
  cp -Rp "$ASDF_DOWNLOAD_PATH/." "$stage/jdk"
else
  ASDF_DOWNLOAD_PATH="$stage/jdk" "$(dirname "$0")/download"
fi

if [ -d "$ASDF_INSTALL_PATH" ]; then
  rmdir "$ASDF_INSTALL_PATH"
fi
mv "$stage/jdk" "$ASDF_INSTALL_PATH"
