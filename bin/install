#!/usr/bin/env bash

installer() {
  local install_type=$1
  local version=$2
  local install_path=$3

  local tmp_download_dir
  tmp_download_dir=$(mktemp -d -t graalvm_XXXXXXX)

  if [ "version" != "${install_type}" ]; then
    echo "The asdf-graalvm plugin only supports installing official"
    echo "binary releases as built by the graal team."
    echo "If you want to install another version from source, see:"
    echo "https://github.com/oracle/graal/"
    exit 1
  fi

  # running this in a subshell
  # we don't want to disturb current working dir
  (
    set -e

    local tar_file
    tar_file=$(downloaded_file_path "$version" "$tmp_download_dir")
    local tar_url
    tar_url=$(download_url "$version")
    download_tar "$tar_file" "$tar_url" || fail "could not download graalvm archive"
    tar zxf "$tar_file" -C "$install_path" --strip-components="$(tar_strip_level)" || fail "failed to extract archive"

  ) || (
    rm -rf "$install_path" "$tmp_download_dir"
    exit 1
  )
}

fail() {
  echo "asdf-graalvm error:" "$*"
  exit 1
}

tar_strip_level() {
  case "$(uname -s)" in
    Linux) echo 1 ;;
    Darwin) echo 3 ;;
    *) fail "$(uname -s) is not supported" ;;
  esac
}

is_new_jdk_format_version() {
  local version=$1
  # Matches versions like 21.0.1 or 24.0.1 or 21.0.3+7.1
  # And does NOT match 22.0.0.2-java8
  if echo "$version" | grep -q -E '^[0-9]+\.[0-9]+\.[0-9]+([+.][0-9a-zA-Z._-]+)*$' && ! echo "$version" | grep -q -E -- "-java[0-9]+$"; then
    return 0 # true
  else
    return 1 # false
  fi
}

get_os_arch_for_new_format() {
  case "$(uname -s)" in
    Linux)
      case "$(uname -m)" in
        x86_64) echo "linux-x64" ;;
        aarch64) echo "linux-aarch64" ;;
        *) fail "$(uname -m) ($(uname -p 2>/dev/null || echo 'N/A')) is not supported on linux for new GraalVM format" ;;
      esac
      ;;
    Darwin)
      case "$(uname -m)" in
        x86_64) echo "macos-x64" ;;
        arm64 | aarch64) echo "macos-aarch64" ;;
        *) fail "$(uname -m) ($(uname -p 2>/dev/null || echo 'N/A')) is not supported on macOS for new GraalVM format" ;;
      esac
      ;;
    *) fail "$(uname -s) is not supported" ;;
  esac
}

get_variant() {
  local version="$1"
  case "$(uname -s)" in
    Linux)
      case "$(uname -m)" in
        x86_64) echo linux-amd64 ;;
        *) fail "$(uname -m) is not supported on linux" ;;
      esac
      ;;
    Darwin)
      case "$(uname -m)" in
        x86_64)
          if version_is_one "$version"; then
            echo macos-amd64
          else
            echo darwin-amd64
          fi
          ;;
        *) fail "$(uname -m) is not supported on macos" ;;
      esac
      ;;
    *) fail "$(uname -s) is not supported" ;;
  esac
}

download_tar() {
  local download_path=$1
  local download_url=$2
  if test "302" != "$(curl -qsI -o /dev/null -w "%{http_code}" "$download_url")"; then
    echo "Could not find archive at URL $download_url"
    exit 2
  fi
  curl -Lo "$download_path" -C - "$download_url"
}

downloaded_file_path() {
  local version=$1
  local tmp_download_dir=$2
  local pkg_name

  if is_new_jdk_format_version "$version"; then
    local os_arch_new_format
    os_arch_new_format=$(get_os_arch_for_new_format)
    pkg_name="graalvm-community-jdk-${version}_${os_arch_new_format}_bin.tar.gz"
  elif version_is_ce_build "$version"; then
    local variant
    variant=$(get_variant "$version")
    local graalvm_version
    graalvm_version=$(echo "$version" | cut -f1 -d-)
    local java_version
    java_version=$(echo "$version" | cut -f2 -d-)
    pkg_name="graalvm-ce-${java_version}-${variant}-${graalvm_version}.tar.gz"
  elif version_is_one "$version"; then
    local variant
    variant=$(get_variant "$version")
    pkg_name="graalvm-ce-${version}-${variant}.tar.gz"
  else # Oracle GraalVM (major version not 1)
    local variant
    variant=$(get_variant "$version")
    pkg_name="graalvm-ce-${variant}-${version}.tar.gz"
  fi
  echo "$tmp_download_dir/$pkg_name"
}

version_is_one() {
  local version=$1
  local major_version
  major_version=$(echo "$version" | cut -d'.' -f 1)
  test "$major_version" -eq 1
}

version_is_ce_build() {
  local version=$1
  echo "$version" | grep -q -E "^.*-java[0-9]+$"
}

download_url() {
  local version=$1
  local variant
  local os_arch_new_format

  if is_new_jdk_format_version "$version"; then
    os_arch_new_format=$(get_os_arch_for_new_format)
    echo "https://github.com/graalvm/graalvm-ce-builds/releases/download/jdk-${version}/graalvm-community-jdk-${version}_${os_arch_new_format}_bin.tar.gz"
  elif version_is_ce_build "$version"; then # Old CE format e.g. 22.3.3-java11
    variant=$(get_variant "$version") # Uses existing get_variant
    local graalvm_version
    graalvm_version=$(echo "$version" | cut -f1 -d-)
    local java_version
    java_version=$(echo "$version" | cut -f2 -d-)
    echo "https://github.com/graalvm/graalvm-ce-builds/releases/download/vm-${graalvm_version}/graalvm-ce-${java_version}-${variant}-${graalvm_version}.tar.gz"
  elif version_is_one "$version"; then # Oracle GraalVM e.g. 19.2.1 (but major version 1)
    variant=$(get_variant "$version")
    echo "https://github.com/oracle/graal/releases/download/vm-${version}/graalvm-ce-${version}-${variant}.tar.gz"
  else # Oracle GraalVM e.g. 20.0.0 (major version not 1)
    variant=$(get_variant "$version")
    echo "https://github.com/oracle/graal/releases/download/vm-${version}/graalvm-ce-${variant}-${version}.tar.gz"
  fi
}

installer "$ASDF_INSTALL_TYPE" "$ASDF_INSTALL_VERSION" "$ASDF_INSTALL_PATH"
