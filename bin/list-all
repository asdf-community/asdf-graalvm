#!/usr/bin/env bash
cmd="curl -s"
if [ -n "$GITHUB_API_TOKEN" ]; then
 cmd="$cmd -H 'Authorization: token $GITHUB_API_TOKEN'"
fi

get_variant() {
  case "$(uname -s)" in
    Linux)
      case "$(uname -m)" in
        x86_64) echo linux-amd64 ;;
        arm64 | aarch64) echo linux-aarch64 ;;
        *) echo "$(uname -m) is not supported on linux" ;;
      esac ;;
    Darwin)
      case "$(uname -m)" in
        x86_64) echo darwin-amd64 ;;
        arm64 | aarch64) echo darwin-aarch64 ;;
        *) echo "$(uname -m) is not supported on macos" ;;
      esac ;;
    *) echo "$(uname -s) is not supported" ;;
  esac
}

(
  "$(dirname "$0")/liberica-nik" list
   eval "$cmd" 'https://api.github.com/repos/graalvm/graalvm-ce-builds/releases' | jq -r 'sort_by(.created_at) | .[] | select (.prerelease == false) | select (.tag_name | contains("vm-")) | select (.assets | length > 0) | .tag_name | ltrimstr("vm-")'
  eval "$cmd" 'https://api.github.com/repos/graalvm/graalvm-ce-builds/releases' | jq -r "sort_by(.created_at) | .[] | select(.prerelease==false) | .assets[].name | capture(\"^graalvm-ce-(?<java>java[0-9]+)-$(get_variant)-(?<version>[0-9\\\.]+)\\\.tar\\\.gz$\") | [.version,.java] | join(\"-\")" | sort
  eval "$cmd" 'https://api.github.com/repos/graalvm/graalvm-ce-builds/releases' | jq -r 'sort_by(.created_at) | .[] | select(.prerelease == false and (.assets | length > 0)) | .tag_name | select(startswith("jdk-")) | ltrimstr("jdk-")'
) | sort -V | xargs echo
